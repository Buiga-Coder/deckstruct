{
    admin off
    auto_https off
}
:8080 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
    handle /healthz {
        respond "ok" 200
    }
    @api path /api /api/*
    handle @api {
        request_body {
            max_size 51MB
        }
        reverse_proxy api:3000
    }
    handle {
        root * /srv
        header Cache-Control no-cache
        file_server
    }
}
