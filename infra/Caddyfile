{
    admin off
    auto_https off
}
:8080 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
    handle /healthz {
        respond "ok" 200
    }
    @api path /api /api/*
    handle @api {
        header Content-Type application/json
        respond `{"message":"Backend is not connected yet","code":"BACKEND_NOT_CONFIGURED"}` 503
    }
    handle {
        root * /srv
        header Cache-Control no-cache
        file_server
    }
}
